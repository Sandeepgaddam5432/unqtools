# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# Rules are evaluated top-to-bottom; the FIRST matching path wins, so we put
# the most specific rules (hashed assets) first and the broad fallback last.

# -----------------------------------------------------------------------------
# Hashed build assets — Vite emits these to /_astro/* with content hashes in
# the filename, so they're safe to cache forever.immutable is critical for
# performance: returning visitors load zero JS on subsequent visits.
# -----------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# -----------------------------------------------------------------------------
# Service worker — must NEVER be cached aggressively, otherwise users get
# stuck on an old SW version and can't pick up new precache manifests.
# Cloudflare also sets `Service-Worker-Allowed: /` implicitly; we restate it
# so the SW can claim root scope even when served from a subpath.
# -----------------------------------------------------------------------------
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# -----------------------------------------------------------------------------
# Manifest — small, changes only at deploy time, but no hash in filename.
# -----------------------------------------------------------------------------
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# -----------------------------------------------------------------------------
# Static icons — never change unless we ship a new icon (rare).
# -----------------------------------------------------------------------------
/icons/*
  Cache-Control: public, max-age=86400

# -----------------------------------------------------------------------------
# Sitemap + robots — re-crawl periodically.
# -----------------------------------------------------------------------------
/sitemap-index.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

# -----------------------------------------------------------------------------
# Default — HTML pages. Always revalidate so deploys are visible immediately.
# `must-revalidate` ensures browsers don't serve a stale HTML page after a
# new deploy lands.
# -----------------------------------------------------------------------------
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
