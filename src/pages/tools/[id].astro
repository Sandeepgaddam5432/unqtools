---
import { TOOLS, byId } from "../../lib/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolLayout from "../../components/ToolLayout.astro";

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { id: t.id }, props: { tool: t } }));
}

const { tool } = Astro.props;
const t = byId(tool.id);
if (!t) {
  return Astro.redirect("/404");
}
const title = t.seo?.title ?? `${t.name} — UnQTools`;
---

<BaseLayout title={title} description={t.description}>
  <ToolLayout tool={t}>
    {
      /* v3.1.1: min-height reserves space for the Preact island BEFORE
        hydration. Without this, the empty #tool-root is ~0px tall, then
        after JS loads the tool UI fills in and pushes everything below it
        down → CLS ~0.12. The 320px min-height approximates the smallest
        tool UI; larger tools grow naturally (min-height, not fixed height). */
    }
    <div id="tool-root" data-tool-id={t.id} data-tool-component style="min-height: 560px;"></div>
  </ToolLayout>
</BaseLayout>

<script>
  // Lazy-mount the tool's Preact island. Each tool's manifest exports a
  // `component` loader; we resolve it here so the heavy code only ships
  // when the user actually opens this tool's page.
  import { render, h } from "preact";
  import { byId } from "../../lib/registry";

  const root = document.getElementById("tool-root");
  const id = root?.dataset.toolId;
  if (root && id) {
    const tool = byId(id);
    if (tool) {
      tool
        .component()
        .then((mod) => {
          const Comp = mod.default;
          render(h(Comp, {}), root);
        })
        .catch((err) => {
          root.innerHTML = `<div class="p-4 bg-unq-danger-subtle border border-unq-danger/40 rounded-lg text-sm text-unq-danger">Failed to load tool: ${err.message}</div>`;
        });
    }
  }
</script>
