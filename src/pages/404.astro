---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — UnQTools">
  <div class="py-16 text-center">
    <p class="text-6xl font-bold text-unq-muted">404</p>
    <h1 class="mt-4 text-2xl">Page not found</h1>
    <p class="mt-2 text-unq-muted">The tool or page you requested does not exist.</p>
    <a href="/" class="unq-btn unq-btn-primary mt-6 inline-flex">Back to all tools</a>
  </div>
</BaseLayout>
