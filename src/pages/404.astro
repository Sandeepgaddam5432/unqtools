---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — UnQTools">
  <div class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="mb-4 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mb-8 text-fg-muted">
      The tool or page you're looking for doesn't exist, or may have moved.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-9 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-accent-fg shadow-soft"
        >Back to home</a
      >
      <button
        onclick="window.dispatchEvent(new CustomEvent('unq:open-command-bar'))"
        class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-surface px-4 text-sm font-medium text-fg transition-colors hover:bg-surface-2"
        >Search tools (⌘K)</button
      >
    </div>
  </div>
</BaseLayout>
