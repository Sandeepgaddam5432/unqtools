---
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../../lib/tool";
import { byCategory } from "../../lib/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return ALL_CATEGORIES.map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params as { category: ToolCategory };
const tools = byCategory(category);
const label = CATEGORY_LABELS[category];
const subtitle = `${tools.length} ${label.toLowerCase()} tool${tools.length === 1 ? "" : "s"} — all private, all offline-capable.`;
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
const allCats = ALL_CATEGORIES.filter((c) => byCategory(c).length > 0);
---

<BaseLayout title={`${label} — UnQTools`} description={subtitle}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-3 flex items-center gap-2">
      <a href="/" class="text-sm text-fg-subtle transition-colors hover:text-fg">All tools</a>
      <span class="text-fg-subtle">›</span>
      <span class="text-sm font-medium text-fg">{label}</span>
    </div>
    <h1 class="mb-2 text-2xl font-bold tracking-tight">{label}</h1>
    <p class="mb-6 text-sm text-fg-muted">{subtitle}</p>

    {/* Filter chips */}
    <div class="mb-6 flex flex-wrap gap-2">
      <a
        href="/"
        class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-fg-muted transition-colors hover:bg-surface-2"
        >All</a
      >
      {
        allCats.map((c) => (
          <a
            href={`/category/${c}`}
            class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium transition-colors ${c === category ? "border-accent bg-accent text-accent-fg" : "border-border text-fg-muted hover:bg-surface-2"}`}
          >
            {CATEGORY_LABELS[c].split(" ")[0]}
          </a>
        ))
      }
    </div>

    {/* Tool grid */}
    {
      tools.length === 0 ? (
        <div class="rounded-xl border border-border bg-surface p-10 text-center">
          <p class="text-fg-muted">No tools in this category yet.</p>
          <a
            href="/"
            class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-accent-fg shadow-soft"
          >
            Browse all tools
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {tools.map((tool) => {
            const glyph = ICON_MAP[tool.icon] ?? tool.icon.slice(0, 2).toUpperCase();
            return (
              <a href={`/tools/${tool.id}`} class="tool-card group block rounded-xl">
                <div class="mb-3 flex items-start justify-between">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft font-mono text-sm text-accent transition-transform group-hover:scale-105">
                    {glyph}
                  </div>
                </div>
                <h3 class="mb-1 text-sm font-semibold tracking-tight transition-colors group-hover:text-accent">
                  {tool.name}
                </h3>
                <p class="line-clamp-2 text-xs leading-relaxed text-fg-muted">{tool.description}</p>
                <div class="mt-3 flex items-center gap-1 text-xs text-fg-subtle opacity-0 transition-opacity group-hover:opacity-100">
                  Open{" "}
                  <svg
                    class="h-3 w-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
