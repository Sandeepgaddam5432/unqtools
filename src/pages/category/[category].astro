---
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../../lib/tool";
import { byCategory } from "../../lib/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";

export function getStaticPaths() {
  return ALL_CATEGORIES.map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params as { category: ToolCategory };
const tools = byCategory(category);
const label = CATEGORY_LABELS[category];
const subtitle = `${tools.length} ${label.toLowerCase()} tool${tools.length === 1 ? "" : "s"} — all private, all offline-capable.`;
---

<BaseLayout title={`${label} — UnQTools`} description={subtitle}>
  <div class="space-y-10">
    <Breadcrumb items={[{ label: "All tools", href: "/" }, { label }]} />

    <header class="space-y-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-widest text-unq-accent">
          Category
        </span>
        <span
          class="inline-flex items-center rounded-full bg-unq-surface-hover px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-unq-text-muted ring-1 ring-unq-border"
        >
          {tools.length} tool{tools.length === 1 ? "" : "s"}
        </span>
      </div>
      <h1 class="text-balance text-3xl font-semibold tracking-display-lg sm:text-4xl lg:text-5xl">
        {label}
      </h1>
      <p class="max-w-2xl text-pretty text-lg leading-relaxed text-unq-text-muted sm:text-xl">
        {subtitle}
      </p>
    </header>

    {
      tools.length === 0 ? (
        <div class="unq-card p-10 text-center">
          <p class="text-pretty text-unq-text-muted">
            No tools in this category yet. The catalog expands every week.
          </p>
          <a
            href="/"
            class="unq-btn-base mt-5 inline-flex h-11 bg-unq-accent px-5 text-sm text-unq-accent-contrast shadow-sm hover:bg-unq-accent-hover hover:shadow-md"
          >
            Browse all tools
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {tools.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
