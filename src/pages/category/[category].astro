---
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../../lib/tool";
import { byCategory } from "../../lib/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Sidebar from "../../components/Sidebar.astro";
import CategoryChips from "../../components/CategoryChips.astro";

export function getStaticPaths() {
  return ALL_CATEGORIES.map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params as { category: ToolCategory };
const tools = byCategory(category);
const label = CATEGORY_LABELS[category];
const subtitle = `${tools.length} ${label.toLowerCase()} tool${tools.length === 1 ? "" : "s"} — all private, all offline-capable.`;

const CATEGORY_ICONS: Record<ToolCategory, string> = {
  pdf: "📄",
  image: "🎨",
  "audio-video": "🎬",
  developer: "{ }",
  seo: "🔍",
  calculators: "🧮",
  text: "Aa",
  "network-security": "🔒",
  file: "📦",
  business: "💼",
  education: "📚",
  social: "👥",
  ai: "✨",
};
const icon = CATEGORY_ICONS[category];
---

<BaseLayout title={`${label} — UnQTools`} description={subtitle}>
  {/* Compact header — breadcrumb + category title + count, no full-screen hero */}
  <section style="padding: 24px 0 16px;">
    <div class="unq-shell" style="grid-template-columns: 1fr; gap: 0;">
      <div style="max-width: 720px;">
        <Breadcrumb items={[{ label: "All tools", href: "/" }, { label }]} />
        <div class="unq-cat-head" style="margin: 16px 0 0 0;">
          <span class="unq-cat-head__icon" aria-hidden="true">{icon}</span>
          <div style="flex: 1; min-width: 0;">
            <p class="unq-eyebrow" style="margin: 0 0 2px 0;">Category</p>
            <h1 class="unq-h1" style="margin: 0; font-size: clamp(1.75rem, 3vw, 2.25rem);">
              {label}
            </h1>
          </div>
          <span
            class="text-unq-text-2 inline-flex items-center rounded-full bg-unq-surface-hover px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider ring-1 ring-unq-border"
            style="min-height: 28px;"
          >
            {tools.length} tool{tools.length === 1 ? "" : "s"}
          </span>
        </div>
        <p
          class="unq-muted"
          style="font-size: 16px; line-height: 1.4; max-width: 580px; margin: 10px 0 0;"
        >
          {subtitle}
        </p>
      </div>
    </div>
  </section>

  {/* Mobile category chip row */}
  <CategoryChips active={category} />

  {/* App shell: sidebar + tool grid */}
  <div class="unq-shell" style="padding-block: 0 64px;">
    <Sidebar active={category} />
    <main class="unq-main">
      {
        tools.length === 0 ? (
          <div class="unq-card" style="padding: 40px; text-align: center;">
            <p class="text-unq-text-2 text-pretty">
              No tools in this category yet. The catalog expands every week.
            </p>
            <a href="/" class="unq-btn" style="margin-top: 20px;">
              Browse all tools
            </a>
          </div>
        ) : (
          <div class="unq-grid unq-reveal">
            {tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        )
      }
    </main>
  </div>
</BaseLayout>
