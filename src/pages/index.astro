---
import { TOOLS, countByCategory } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import BaseLayout from "../layouts/BaseLayout.astro";

const counts = countByCategory();
const cats = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
const toolCount = TOOLS.length;

const featuredIds = ["json-formatter", "diff-checker", "caesar-cipher", "color-picker"];
const featured = featuredIds
  .map((id) => TOOLS.find((t) => t.id === id))
  .filter(Boolean)
  .slice(0, 4);

const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
---

<BaseLayout>
  {/* Hero */}
  <section class="hero">
    <div style="max-width:720px;margin:0 auto;">
      <p class="eyebrow" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:12px;">
        <span
          style="width:6px;height:6px;border-radius:50%;background:var(--success);display:inline-block;"
        ></span>
        100% private · runs in your browser
      </p>
      <h1 class="hero__title">Tools that respect your data.</h1>
      <p class="hero__subtitle">
        {toolCount} fast, free, offline-capable browser tools — converters, calculators, generators,
        formatters. No uploads, no tracking, no accounts.
      </p>
      <div class="hero__search-wrap">
        <button
          class="topbar__search"
          id="hero-search-trigger"
          style="width:100%;height:44px;"
          aria-label="Search tools"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
          >
          <span>Search tools by name, category, or keyword…</span>
          <span class="topbar__search-hint">⌘K</span>
        </button>
      </div>
      <div class="hero__trust">
        <span class="hero__trust-item">✓ No sign-up</span>
        <span class="hero__trust-item">✓ No tracking</span>
        <span class="hero__trust-item">✓ Works offline</span>
      </div>
    </div>
  </section>

  {/* Stats strip */}
  <div class="stats-strip">
    <span><strong>{toolCount}</strong> tools</span>
    <span>·</span>
    <span><strong>529</strong> tests passing</span>
    <span>·</span>
    <span><strong>0</strong> bytes sent to a server</span>
    <span>·</span>
    <span><strong>100%</strong> offline-capable</span>
  </div>

  {/* Featured bento */}
  {
    featured.length > 0 && (
      <section style="margin-top:32px;">
        <div class="section-head">
          <div>
            <p class="eyebrow" style="margin:0 0 4px;">
              Popular this week
            </p>
            <h2 style="font-size:var(--text-h2);margin:0;">Featured tools</h2>
          </div>
        </div>
        <div class="bento reveal">
          {featured.map((t) => {
            const glyph = ICON_MAP[t!.icon] ?? t!.icon.slice(0, 2).toUpperCase();
            return (
              <a href={`/tools/${t!.id}`} class="card">
                <span class="card__icon" aria-hidden="true">
                  {glyph}
                </span>
                <h3 class="card__title">{t!.name}</h3>
                <p class="card__desc">{t!.description}</p>
                <p class="card__cat">{CATEGORY_LABELS[t!.category].split(" ")[0]}</p>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  {/* All tools grid */}
  <section style="margin-top:32px;">
    <div class="section-head">
      <div>
        <p class="eyebrow" style="margin:0 0 4px;">All tools</p>
        <h2 style="font-size:var(--text-h2);margin:0;">Browse everything</h2>
      </div>
      <span class="section-head__count">{toolCount} total</span>
    </div>
    <div class="tool-grid reveal">
      {
        TOOLS.map((t) => {
          const glyph = ICON_MAP[t.icon] ?? t.icon.slice(0, 2).toUpperCase();
          return (
            <a href={`/tools/${t.id}`} class="card">
              <span class="card__icon" aria-hidden="true">
                {glyph}
              </span>
              <h3 class="card__title">{t.name}</h3>
              <p class="card__desc">{t.description}</p>
              <p class="card__cat">{CATEGORY_LABELS[t.category].split(" ")[0]}</p>
            </a>
          );
        })
      }
    </div>
  </section>

  {/* Category sections */}
  {
    cats.map((c, i) => {
      const tools = TOOLS.filter((t) => t.category === c);
      return (
        <section style={`margin-top:32px;${i % 2 === 1 ? "" : ""}`}>
          <div class="section-head">
            <div>
              <p class="eyebrow" style="margin:0 0 4px;">
                {tools.length} tool{tools.length === 1 ? "" : "s"}
              </p>
              <h2 style="font-size:var(--text-h2);margin:0;">{CATEGORY_LABELS[c]}</h2>
            </div>
            <a href={`/category/${c}`} class="cta-link">
              View all
            </a>
          </div>
          <div class="tool-grid reveal">
            {tools.slice(0, 8).map((t) => {
              const glyph = ICON_MAP[t.icon] ?? t.icon.slice(0, 2).toUpperCase();
              return (
                <a href={`/tools/${t.id}`} class="card">
                  <span class="card__icon" aria-hidden="true">
                    {glyph}
                  </span>
                  <h3 class="card__title">{t.name}</h3>
                  <p class="card__desc">{t.description}</p>
                  <p class="card__cat">{CATEGORY_LABELS[t.category].split(" ")[0]}</p>
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }

  {/* CTA band */}
  <section style="margin-top:48px;" class="reveal">
    <div class="cta-band">
      <p class="eyebrow" style="margin:0;">Install UnQTools</p>
      <h2 style="font-size:var(--text-h2);margin:0;max-width:540px;">
        Add it to your home screen. Works offline, no account.
      </h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:4px;">
        <button class="btn" onclick="window.dispatchEvent(new CustomEvent('unq:install-prompt'))">
          Install UnQTools
        </button>
        <a href="/category/developer" class="btn btn--secondary">Browse tools</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.getElementById("hero-search-trigger")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
  });
</script>
