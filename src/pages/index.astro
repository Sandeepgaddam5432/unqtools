---
import { TOOLS, countByCategory } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import BaseLayout from "../layouts/BaseLayout.astro";

const counts = countByCategory();
const cats = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
const toolCount = TOOLS.length;
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-24">
      <div
        class="mb-6 inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 text-xs text-fg-muted"
      >
        <svg
          class="h-3 w-3 text-accent"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="M12 3l1.9 5.8L20 10l-5.8 1.9L12 18l-1.9-6.1L4 10l6.1-1.2L12 3z"></path></svg
        >
        100% client-side · Privacy-first · No backend
      </div>
      <h1 class="text-balance text-4xl font-bold tracking-tight lg:text-5xl">
        Every utility you need.
        <br />
        <span class="text-fg-muted">Nothing leaves your browser.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-pretty text-base text-fg-muted lg:text-lg">
        {toolCount} premium calculators, converters, and productivity tools — built to last, engineered
        for speed, and designed to respect your privacy.
      </p>
      <div class="mx-auto mt-8 max-w-xl">
        <button
          id="hero-search"
          class="flex h-12 w-full cursor-pointer items-center gap-2 rounded-xl border border-border bg-surface pl-4 pr-4 text-sm text-fg-subtle shadow-soft transition-colors hover:bg-surface-2"
          aria-label="Search tools"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
          >
          <span class="flex-1 text-left"
            >Search {toolCount}+ tools — JSON, diff, EMI, word counter…</span
          >
          <kbd
            class="inline-flex items-center rounded border border-border bg-surface-2 px-1.5 py-0.5 font-mono text-2xs font-medium"
            >⌘K</kbd
          >
        </button>
      </div>
      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs text-fg-subtle"
      >
        <span class="flex items-center gap-1.5">
          <svg
            class="h-3.5 w-3.5 text-success"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
              d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
          >
          No data uploaded
        </span>
        <span class="flex items-center gap-1.5">
          <svg
            class="h-3.5 w-3.5 text-warning"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
          >
          Runs in your browser
        </span>
        <span class="flex items-center gap-1.5">
          <svg
            class="h-3.5 w-3.5 text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          Open-source libraries
        </span>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    {/* Categories — ported from toolhub's category section pattern */}
    {
      cats.map((cat) => {
        const tools = TOOLS.filter((t) => t.category === cat);
        return (
          <section class="mb-10">
            <div class="mb-3 flex items-center justify-between">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-fg-muted">
                {CATEGORY_LABELS[cat]}
              </h2>
              <span class="text-xs text-fg-subtle">
                {tools.length} tool{tools.length === 1 ? "" : "s"}
              </span>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {tools.map((tool) => {
                const glyph = ICON_MAP[tool.icon] ?? tool.icon.slice(0, 2).toUpperCase();
                return (
                  <a
                    href={`/tools/${tool.id}`}
                    class="tool-card group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
                  >
                    <div class="mb-3 flex items-start justify-between">
                      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft font-mono text-sm text-accent transition-transform group-hover:scale-105">
                        {glyph}
                      </div>
                    </div>
                    <h3 class="mb-1 text-sm font-semibold tracking-tight transition-colors group-hover:text-accent">
                      {tool.name}
                    </h3>
                    <p class="line-clamp-2 text-xs leading-relaxed text-fg-muted">
                      {tool.description}
                    </p>
                    <div class="mt-3 flex items-center gap-1 text-xs text-fg-subtle opacity-0 transition-opacity group-hover:opacity-100">
                      Open
                      <svg
                        class="h-3 w-3"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<script is:inline>
  document.getElementById("hero-search")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
