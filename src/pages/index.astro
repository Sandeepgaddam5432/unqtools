---
import { TOOLS, countByCategory } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import BaseLayout from "../layouts/BaseLayout.astro";

const counts = countByCategory();
const cats = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
const toolCount = TOOLS.length;
const featuredIds = ["json-formatter", "diff-checker", "caesar-cipher", "color-picker"];
const featured = featuredIds
  .map((id) => TOOLS.find((t) => t.id === id))
  .filter(Boolean)
  .slice(0, 4);
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
---

<BaseLayout>
  {/* Hero with aurora + floating blobs */}
  <section class="hero">
    <div class="aurora-bg absolute inset-0 opacity-60"></div>
    <div class="blob blob--blue" style="top:25%;left:25%;"></div>
    <div class="blob blob--orange" style="bottom:25%;right:25%;"></div>
    <div class="hero__inner">
      <h1 class="hero__title">
        <span class="gradient-text">Tools</span> that respect<br />your data.
      </h1>
      <p class="hero__subtitle">
        {toolCount} fast, free, offline-capable browser tools — converters, calculators, generators,
        formatters. No uploads, no tracking, no accounts.
      </p>
      <div class="hero__terminal">
        <span class="hero__terminal-prompt">$</span>
        <span style="color:#fff;">uipro init --ai claude</span>
        <span class="hero__terminal-cursor" style="color:#fff;">▋</span>
      </div>
      <div class="hero__ctas">
        <a href="#tools" class="btn-primary">Browse tools</a>
        <button
          class="btn-secondary"
          onclick="window.dispatchEvent(new CustomEvent('unq:open-command-bar'))"
        >
          Search (⌘K)
        </button>
      </div>
    </div>
  </section>

  {/* Stats grid */}
  <section class="content-wrap" style="padding-top:0;padding-bottom:48px;">
    <div class="stats-grid">
      <div class="glass-card glass-card-hover stat-tile">
        <div class="stat-tile__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-2.733a2.548 2.548 0 1 0-3.586-3.586l-9.408 9.408"
            ></path></svg
          >
        </div>
        <div class="stat-tile__num gradient-text" data-countup={toolCount}>0</div>
        <div class="stat-tile__label">Tools live</div>
      </div>
      <div class="glass-card glass-card-hover stat-tile">
        <div class="stat-tile__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6Zm0 9.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25Zm9.75-9.75A2.25 2.25 0 0 1 15.75 3.75H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6Z"
            ></path></svg
          >
        </div>
        <div class="stat-tile__num gradient-text" data-countup="13">0</div>
        <div class="stat-tile__label">Categories</div>
      </div>
      <div class="glass-card glass-card-hover stat-tile">
        <div class="stat-tile__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.746 3.746 0 0 1 21 12Z"
            ></path></svg
          >
        </div>
        <div class="stat-tile__num gradient-text" data-countup="100">0</div>
        <div class="stat-tile__label">% private</div>
      </div>
      <div class="glass-card glass-card-hover stat-tile">
        <div class="stat-tile__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z"
            ></path></svg
          >
        </div>
        <div class="stat-tile__num gradient-text" data-countup="0">0</div>
        <div class="stat-tile__label">Bytes uploaded</div>
      </div>
    </div>
  </section>

  {/* Featured bento */}
  {
    featured.length > 0 && (
      <section class="section content-wrap" id="tools">
        <div class="section-head">
          <div>
            <p class="eyebrow" style="margin:0 0 4px;">
              Popular this week
            </p>
            <h2>
              <span class="gradient-text">Featured</span> tools
            </h2>
          </div>
        </div>
        <div class="bento reveal">
          {featured.map((t) => {
            const glyph = ICON_MAP[t!.icon] ?? t!.icon.slice(0, 2).toUpperCase();
            return (
              <a href={`/tools/${t!.id}`} class="glass-card glass-card-hover card">
                <span class="card__icon" aria-hidden="true">
                  {glyph}
                </span>
                <h3 class="card__title">{t!.name}</h3>
                <p class="card__desc">{t!.description}</p>
                <div class="card__tags">
                  <span class="card__tag">{CATEGORY_LABELS[t!.category].split(" ")[0]}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  {/* All tools grid */}
  <section class="section section--alt content-wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow" style="margin:0 0 4px;">All tools</p>
        <h2>Browse <span class="gradient-text">everything</span></h2>
      </div>
      <span class="section-head__count">{toolCount} total</span>
    </div>
    <div class="tool-grid reveal">
      {
        TOOLS.map((t) => {
          const glyph = ICON_MAP[t.icon] ?? t.icon.slice(0, 2).toUpperCase();
          return (
            <a href={`/tools/${t.id}`} class="glass-card glass-card-hover card">
              <span class="card__icon" aria-hidden="true">
                {glyph}
              </span>
              <h3 class="card__title">{t.name}</h3>
              <p class="card__desc">{t.description}</p>
              <div class="card__tags">
                <span class="card__tag">{CATEGORY_LABELS[t.category].split(" ")[0]}</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  {/* Category sections */}
  {
    cats.map((c) => {
      const tools = TOOLS.filter((t) => t.category === c);
      return (
        <section class="section content-wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow" style="margin:0 0 4px;">
                {tools.length} tool{tools.length === 1 ? "" : "s"}
              </p>
              <h2>
                {CATEGORY_LABELS[c].split(" ")[0]}{" "}
                <span class="gradient-text">
                  {CATEGORY_LABELS[c].split(" ").slice(1).join(" ")}
                </span>
              </h2>
            </div>
            <a href={`/category/${c}`} class="cta-link">
              View all
            </a>
          </div>
          <div class="tool-grid reveal">
            {tools.slice(0, 8).map((t) => {
              const glyph = ICON_MAP[t.icon] ?? t.icon.slice(0, 2).toUpperCase();
              return (
                <a href={`/tools/${t.id}`} class="glass-card glass-card-hover card">
                  <span class="card__icon" aria-hidden="true">
                    {glyph}
                  </span>
                  <h3 class="card__title">{t.name}</h3>
                  <p class="card__desc">{t.description}</p>
                  <div class="card__tags">
                    <span class="card__tag">{CATEGORY_LABELS[t.category].split(" ")[0]}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }

  {/* CTA band */}
  <section class="section content-wrap">
    <div
      class="glass-card aurora-bg"
      style="padding:clamp(32px,5vw,56px);text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px;"
    >
      <p class="eyebrow" style="margin:0;">Install UnQTools</p>
      <h2 style="font-size:var(--text-h2);max-width:540px;">
        Add it to your home screen. Works offline, no account.
      </h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:4px;">
        <button
          class="btn-primary"
          onclick="window.dispatchEvent(new CustomEvent('unq:install-prompt'))"
          >Install UnQTools</button
        >
        <a href="/category/developer" class="btn-secondary">Browse tools</a>
      </div>
    </div>
  </section>
</BaseLayout>
