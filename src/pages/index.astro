---
import { TOOLS, countByCategory } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import SearchBar from "../components/SearchBar.astro";

const counts = countByCategory();
const categoriesWithTools = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
const toolCount = TOOLS.length;
---

<BaseLayout>
  <!-- ════════════════════════════════════════════════════════════ HERO
       Apple.com pattern: white background, centered, max-width ~720px,
       generous top air, eyebrow + hero title + muted subtitle + search. -->
  <section
    class="unq-section"
    style="padding-top: clamp(72px, 11vw, 140px); padding-bottom: clamp(40px, 6vw, 72px);"
  >
    <div class="unq-container" style="max-width: 720px; text-align: center;">
      <p
        class="unq-eyebrow"
        style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;"
      >
        <span
          aria-hidden="true"
          style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--unq-success);"
        ></span>
        100% private · runs in your browser
      </p>
      <h1 class="unq-hero-title" style="margin: 0;">Tools that respect your data.</h1>
      <p
        class="unq-muted"
        style="font-size: 21px; line-height: 1.4; margin: 20px auto 0; max-width: 620px;"
      >
        {toolCount} fast, free, offline-capable browser tools — converters, calculators, generators,
        formatters. No uploads, no tracking, no accounts.
      </p>
      <div style="margin: 32px auto 0; max-width: 620px;">
        <SearchBar />
      </div>
      <p style="margin-top: 14px; font-size: 12px; color: var(--unq-text-3);">
        Press
        <kbd
          class="inline-flex h-5 items-center rounded border border-unq-border bg-unq-surface-hover px-1.5 font-mono text-[10px]"
          >⌘K</kbd
        >
        anywhere to search
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ Favorites + Recents
       Reactive — populated client-side; hidden by default. -->
  <section id="retention-rows" class="unq-section--gray" style="padding: 32px 0;" hidden>
    <div class="unq-container" style="display: flex; flex-direction: column; gap: 40px;">
      <div>
        <h2
          class="unq-h3"
          style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon>
          </svg>
          Favorites
        </h2>
        <div id="favorites-grid" class="unq-grid"></div>
      </div>
      <div>
        <h2
          class="unq-h3"
          style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Recently used
        </h2>
        <div id="recents-grid" class="unq-grid"></div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ Category sections
       Apple.com pattern: ALTERNATING .unq-section (white) and
       .unq-section--gray (gray). Each section has a .unq-container >
       .unq-section-head (h2 + "View all" cta-link) > .unq-grid of ToolCards,
       wrapped in .unq-reveal for staggered entrance. -->
  {
    categoriesWithTools.map((c, i) => {
      const tools = TOOLS.filter((t) => t.category === c);
      const isGray = i % 2 === 1; // alternate
      return (
        <section class={isGray ? "unq-section unq-section--gray" : "unq-section"}>
          <div class="unq-container">
            <div class="unq-section-head">
              <h2 class="unq-h2">{CATEGORY_LABELS[c]}</h2>
              <a href={`/category/${c}`} class="unq-cta-link">
                View all
              </a>
            </div>
            <div class="unq-grid unq-reveal">
              {tools.slice(0, 8).map((t) => (
                <ToolCard tool={t} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<!-- Reactive favorites/recents hydration script (pure DOM, no Preact island) -->
<script>
  import { TOOLS } from "../lib/registry";
  import { CATEGORY_LABELS } from "../lib/tool";

  const FAV_KEY = "unq-favorites";
  const RECENT_KEY = "unq-recents";

  function readList(key: string): string[] {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as string[]) : [];
    } catch {
      return [];
    }
  }

  function renderRow(gridId: string, ids: string[]) {
    const grid = document.getElementById(gridId);
    if (!grid) return;
    if (ids.length === 0) {
      grid.innerHTML = "";
      return;
    }
    const tools = ids
      .map((id) => TOOLS.find((t) => t.id === id))
      .filter((t): t is NonNullable<typeof t> => Boolean(t));
    grid.innerHTML = tools
      .map(
        (t) => `
      <a href="/tools/${t.id}" class="unq-card unq-card-interactive group block">
        <h3 class="unq-card__title duration-normal transition-colors ease-apple group-hover:text-unq-accent">${t.name}</h3>
        <p class="unq-card__desc mt-1.5 line-clamp-2">${t.description}</p>
        <p class="unq-card__cat">
          ${CATEGORY_LABELS[t.category].split(" ")[0]}
        </p>
      </a>`,
      )
      .join("");
  }

  function refreshRetentionRows() {
    const favorites = readList(FAV_KEY);
    const recents = readList(RECENT_KEY);
    const section = document.getElementById("retention-rows");
    if (!section) return;
    if (favorites.length === 0 && recents.length === 0) {
      section.hidden = true;
      return;
    }
    section.hidden = false;
    renderRow("favorites-grid", favorites.slice(0, 4));
    renderRow("recents-grid", recents.slice(0, 4));
  }

  refreshRetentionRows();
  window.addEventListener("storage", refreshRetentionRows);
  window.addEventListener("unq:favorite-changed", refreshRetentionRows);
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
