---
import { TOOLS, countByCategory } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import SearchBar from "../components/SearchBar.astro";

const counts = countByCategory();
const categoriesWithTools = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
const toolCount = TOOLS.length;
---

<BaseLayout>
  <!-- Hero -->
  <section class="py-8 text-center sm:py-16">
    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full bg-unq-accent-subtle px-3 py-1 text-xs font-medium text-unq-accent"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-unq-accent opacity-75"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-unq-accent"></span>
      </span>
      100% private · runs in your browser
    </div>
    <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
      <span class="unq-gradient-text">Tools that respect</span><br />
      <span class="unq-gradient-text">your data.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-pretty text-base text-unq-text-muted sm:text-lg">
      {toolCount} fast, free, offline-capable browser tools — converters, calculators, generators, formatters.
      No uploads, no tracking, no accounts.
    </p>
    <div class="mx-auto mt-8 max-w-xl">
      <SearchBar />
    </div>
    <p class="mt-3 text-xs text-unq-text-subtle">
      Press <kbd
        class="inline-flex h-5 items-center rounded border border-unq-border bg-unq-surface-hover px-1.5 font-mono text-[10px]"
        >⌘K</kbd
      > anywhere to search
    </p>
  </section>

  <!-- Favorites + Recents (reactive — populated client-side) -->
  <section id="retention-rows" class="mb-12 space-y-6" hidden>
    <div>
      <h2
        class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-unq-text-subtle"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          ></polygon>
        </svg>
        Favorites
      </h2>
      <div id="favorites-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
    </div>
    <div>
      <h2
        class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-unq-text-subtle"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        Recently used
      </h2>
      <div id="recents-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
    </div>
  </section>

  <!-- Category sections -->
  {
    categoriesWithTools.map((c) => {
      const tools = TOOLS.filter((t) => t.category === c);
      return (
        <section class="mb-12">
          <div class="mb-4 flex items-baseline justify-between">
            <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{CATEGORY_LABELS[c]}</h2>
            <a
              href={`/category/${c}`}
              class="text-sm text-unq-text-muted transition-colors duration-fast hover:text-unq-text"
            >
              View all →
            </a>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {tools.slice(0, 8).map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<!-- Reactive favorites/recents hydration script (no Preact island needed — pure DOM) -->
<script>
  import { TOOLS } from "../lib/registry";
  import { CATEGORY_LABELS } from "../lib/tool";

  const FAV_KEY = "unq-favorites";
  const RECENT_KEY = "unq-recents";

  function readList(key: string): string[] {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as string[]) : [];
    } catch {
      return [];
    }
  }

  function renderRow(gridId: string, ids: string[]) {
    const grid = document.getElementById(gridId);
    if (!grid) return;
    if (ids.length === 0) {
      grid.innerHTML = "";
      return;
    }
    const tools = ids
      .map((id) => TOOLS.find((t) => t.id === id))
      .filter((t): t is NonNullable<typeof t> => Boolean(t));
    grid.innerHTML = tools
      .map(
        (t) => `
      <a href="/tools/${t.id}" class="unq-card unq-card-interactive group p-4 block">
        <h3 class="font-semibold text-sm group-hover:text-unq-accent transition-colors">${t.name}</h3>
        <p class="text-xs text-unq-text-muted mt-1 line-clamp-2">${t.description}</p>
        <p class="text-[10px] uppercase tracking-wider text-unq-text-subtle mt-3 font-medium">
          ${CATEGORY_LABELS[t.category].split(" ")[0]}
        </p>
      </a>`,
      )
      .join("");
  }

  function refreshRetentionRows() {
    const favorites = readList(FAV_KEY);
    const recents = readList(RECENT_KEY);
    const section = document.getElementById("retention-rows");
    if (!section) return;
    if (favorites.length === 0 && recents.length === 0) {
      section.hidden = true;
      return;
    }
    section.hidden = false;
    renderRow("favorites-grid", favorites.slice(0, 4));
    renderRow("recents-grid", recents.slice(0, 4));
  }

  // Initial render + listen for storage changes from other tabs
  refreshRetentionRows();
  window.addEventListener("storage", refreshRetentionRows);
  // Listen for in-page favorite toggles
  window.addEventListener("unq:favorite-changed", refreshRetentionRows);
</script>
