---
import { TOOLS } from "../lib/registry";

const year = new Date().getFullYear();
const toolCount = TOOLS.length;

// Popular tools for the footer column (4 most-likely-useful)
const popularIds = ["json-formatter", "base64", "image-compressor", "color-picker"];
const popular = popularIds
  .map((id) => TOOLS.find((t) => t.id === id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t))
  .slice(0, 4);
---

<footer
  class="unq-section--gray"
  style="border-top: 1px solid var(--border); padding: clamp(56px, 8vw, 80px) 0 32px;"
>
  <div class="unq-container">
    <div class="unq-foot-grid">
      {/* Col 1 — brand + tagline */}
      <div class="unq-foot-col">
        <a
          href="/"
          class="flex items-center gap-2.5 font-semibold tracking-tight text-fg"
          aria-label="UnQTools home"
          style="min-height: 36px;"
        >
          <span class="unq-brand-mark">U</span>
          <span class="text-base tracking-tight">UnQTools</span>
        </a>
        <p class="mt-4 max-w-xs text-pretty text-sm leading-relaxed text-fg-muted">
          {toolCount} browser-based tools — all private, all offline-capable. Your data never leaves
          your device.
        </p>
      </div>

      {/* Col 2 — Categories */}
      <div class="unq-foot-col">
        <h3>Categories</h3>
        <ul>
          <li><a href="/category/developer">Developer &amp; Code</a></li>
          <li><a href="/category/calculators">Calculators</a></li>
          <li><a href="/category/text">Text &amp; Writing</a></li>
          <li><a href="/category/image">Image &amp; Graphics</a></li>
          <li><a href="/category/network-security">Security &amp; Privacy</a></li>
        </ul>
      </div>

      {/* Col 3 — Popular tools */}
      <div class="unq-foot-col">
        <h3>Popular tools</h3>
        <ul>
          {
            popular.map((t) => (
              <li>
                <a href={`/tools/${t.id}`}>{t.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Col 4 — About + Legal */}
      <div class="unq-foot-col">
        <h3>About</h3>
        <ul>
          <li>100% private</li>
          <li>Installable PWA</li>
          <li>No accounts, no tracking</li>
          <li>Works offline</li>
          <li>
            <a
              href="https://github.com/Sandeepgaddam5432/unqtools/blob/main/LICENSE"
              target="_blank"
              rel="noopener"
            >
              View LICENSE
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border pt-7 text-xs text-fg-subtle sm:flex-row sm:items-center"
    >
      <p>&copy; {year} UnQTools. All rights reserved.</p>
      <p>Proprietary &amp; confidential · Built with Astro · 100% static</p>
    </div>
  </div>
</footer>
