---
const year = new Date().getFullYear();
const toolCount = (await import("../lib/registry")).TOOLS.length;
---

<footer
  class="unq-section--gray"
  style="border-top: 1px solid var(--unq-border); padding: 80px 0 40px;"
>
  <div class="unq-container">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-8">
      <div class="sm:col-span-1">
        <a
          href="/"
          class="flex items-center gap-2.5 font-semibold tracking-tight text-unq-text"
          aria-label="UnQTools home"
        >
          <span class="unq-brand-mark">U</span>
          <span class="text-base tracking-tight">UnQTools</span>
        </a>
        <p class="text-unq-text-3 mt-4 max-w-xs text-pretty text-sm leading-relaxed">
          {toolCount} browser-based tools — all private, all offline-capable. Your data never leaves
          your device.
        </p>
      </div>

      <div>
        <p class="text-unq-text-3 mb-4 text-xs font-semibold uppercase tracking-widest">Product</p>
        <ul class="text-unq-text-3 space-y-2.5 text-sm">
          <li>
            <a href="/" class="duration-normal transition-colors ease-apple hover:text-unq-text"
              >All tools</a
            >
          </li>
          <li>
            <a
              href="/category/developer"
              class="duration-normal transition-colors ease-apple hover:text-unq-text">Developer</a
            >
          </li>
          <li>
            <a
              href="/category/calculators"
              class="duration-normal transition-colors ease-apple hover:text-unq-text"
              >Calculators</a
            >
          </li>
          <li>
            <a
              href="/category/text"
              class="duration-normal transition-colors ease-apple hover:text-unq-text"
              >Text &amp; Writing</a
            >
          </li>
          <li>
            <a
              href="/category/image"
              class="duration-normal transition-colors ease-apple hover:text-unq-text">Image</a
            >
          </li>
        </ul>
      </div>

      <div>
        <p class="text-unq-text-3 mb-4 text-xs font-semibold uppercase tracking-widest">About</p>
        <ul class="text-unq-text-3 space-y-2.5 text-sm">
          <li>100% private</li>
          <li>Installable PWA</li>
          <li>No accounts, no tracking</li>
          <li>Works offline</li>
        </ul>
      </div>
    </div>

    <div
      class="text-unq-text-3 mt-12 flex flex-col items-start justify-between gap-3 border-t border-unq-border pt-7 text-xs sm:flex-row sm:items-center"
    >
      <p>&copy; {year} UnQTools. Proprietary &amp; confidential. All rights reserved.</p>
      <p>
        <a
          href="https://github.com/Sandeepgaddam5432/unqtools/blob/main/LICENSE"
          class="duration-normal underline underline-offset-2 transition-colors ease-apple hover:text-unq-text"
          target="_blank"
          rel="noopener"
        >
          View LICENSE
        </a>
      </p>
    </div>
  </div>
</footer>
