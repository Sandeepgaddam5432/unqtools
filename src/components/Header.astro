---
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import { countByCategory } from "../lib/registry";

const counts = countByCategory();
const navCategories = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0).slice(0, 8);
---

<header
  class="unq-glass border-unq-border/60 duration-normal sticky top-0 z-40 border-b transition-all ease-apple"
  data-header
>
  <div class="unq-container flex h-14 items-center justify-between gap-3 sm:h-16">
    <!-- Logo — Apple-grade: minimal, refined -->
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 font-semibold tracking-tight"
      aria-label="UnQTools home"
    >
      <span
        class="duration-normal inline-flex h-8 w-8 items-center justify-center rounded-lg bg-unq-accent text-sm font-bold text-unq-accent-contrast shadow-sm transition-transform ease-apple group-hover:scale-105"
      >
        U
      </span>
      <span class="hidden text-base tracking-tight sm:inline">UnQTools</span>
    </a>

    <!-- Nav (desktop) — Apple-grade: minimal labels, generous spacing -->
    <nav aria-label="Primary" class="hidden items-center gap-1 text-sm lg:flex">
      {
        navCategories.map((c) => (
          <a
            href={`/category/${c}`}
            class="duration-normal whitespace-nowrap rounded-full px-3 py-1.5 text-unq-text-muted transition-all ease-apple hover:bg-unq-surface-hover hover:text-unq-text"
          >
            {CATEGORY_LABELS[c].split(" ")[0]}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- ⌘K trigger — Apple-grade pill -->
      <button
        id="cmdk-trigger"
        type="button"
        class="duration-normal flex h-9 min-w-[40px] items-center gap-2 rounded-full border border-unq-border bg-unq-surface px-3 text-sm text-unq-text-muted transition-all ease-apple hover:border-unq-border-strong hover:bg-unq-surface-hover sm:min-w-[220px]"
        aria-label="Open command palette (⌘K)"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden flex-1 text-left sm:inline">Search tools…</span>
        <kbd
          class="hidden h-5 items-center gap-0.5 rounded border border-unq-border bg-unq-bg px-1.5 font-mono text-[10px] text-unq-text-subtle sm:flex"
        >
          ⌘K
        </kbd>
      </button>

      <!-- Theme toggle — Apple-grade minimal icon -->
      <button
        id="theme-toggle"
        type="button"
        class="duration-normal flex h-9 w-9 items-center justify-center rounded-full text-unq-text-muted transition-all ease-apple hover:bg-unq-surface-hover hover:text-unq-text"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <svg
          id="theme-icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          id="theme-icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Inline scripts: theme toggle + ⌘K trigger -->
  <script is:inline>
    (function () {
      const KEY = "unq-theme";
      const btn = document.getElementById("theme-toggle");
      const sun = document.getElementById("theme-icon-sun");
      const moon = document.getElementById("theme-icon-moon");
      function current() {
        const v = localStorage.getItem(KEY);
        return v === "light" || v === "dark" || v === "system" ? v : "system";
      }
      function resolved(t) {
        if (t === "system") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        return t;
      }
      function paint() {
        const t = current();
        const r = resolved(t);
        if (sun && moon) {
          sun.classList.toggle("hidden", r !== "light");
          moon.classList.toggle("hidden", r !== "dark");
        }
      }
      btn?.addEventListener("click", () => {
        const cur = resolved(current());
        const next = cur === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem(KEY, next);
        paint();
      });
      paint();
    })();
  </script>
  <script is:inline>
    document.addEventListener("keydown", function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
      }
    });
    document.getElementById("cmdk-trigger")?.addEventListener("click", function () {
      window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
    });
  </script>
</header>
