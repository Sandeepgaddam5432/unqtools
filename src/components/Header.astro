---
import { ALL_CATEGORIES, CATEGORY_LABELS } from "../lib/tool";
import { countByCategory } from "../lib/registry";

const counts = countByCategory();
const navCategories = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0).slice(0, 8);
---

<header class="unq-nav unq-glass" data-header>
  <div class="unq-nav-inner">
    <!-- Brand — Apple-grade: minimal square mark + wordmark -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-unq-text"
      aria-label="UnQTools home"
      style="min-height: 36px;"
    >
      <span class="unq-brand-mark">U</span>
      <span class="hidden text-sm font-semibold tracking-tight sm:inline">UnQTools</span>
    </a>

    <!-- Nav links (desktop) — Apple.com pattern: neutral labels, generous gap -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="unq-nav-links">
        {
          navCategories.map((c) => (
            <li>
              <a href={`/category/${c}`}>{CATEGORY_LABELS[c].split(" ")[0]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Actions — ⌘K trigger + theme toggle -->
    <div class="flex items-center gap-2">
      <button
        id="cmdk-trigger"
        type="button"
        class="duration-normal text-unq-text-2 ease-apple flex h-9 min-w-[40px] items-center gap-2 rounded-full border border-unq-border bg-unq-surface px-3 text-sm transition-all hover:border-unq-border-strong hover:bg-unq-surface-hover sm:min-w-[220px]"
        aria-label="Open command palette (⌘K)"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden flex-1 text-left sm:inline">Search tools…</span>
        <kbd
          class="text-unq-text-3 hidden h-5 items-center gap-0.5 rounded border border-unq-border bg-unq-bg px-1.5 font-mono text-[10px] sm:flex"
        >
          ⌘K
        </kbd>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="unq-icon-btn"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <svg
          id="theme-icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          id="theme-icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Inline scripts: theme toggle + ⌘K trigger -->
  <script is:inline>
    (function () {
      const KEY = "unq-theme";
      const btn = document.getElementById("theme-toggle");
      const sun = document.getElementById("theme-icon-sun");
      const moon = document.getElementById("theme-icon-moon");
      function current() {
        const v = localStorage.getItem(KEY);
        return v === "light" || v === "dark" || v === "system" ? v : "system";
      }
      function resolved(t) {
        if (t === "system") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        return t;
      }
      function paint() {
        const t = current();
        const r = resolved(t);
        if (sun && moon) {
          sun.classList.toggle("hidden", r !== "light");
          moon.classList.toggle("hidden", r !== "dark");
        }
      }
      btn?.addEventListener("click", () => {
        const cur = resolved(current());
        const next = cur === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem(KEY, next);
        paint();
      });
      paint();
    })();
  </script>
  <script is:inline>
    document.addEventListener("keydown", function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
      }
    });
    document.getElementById("cmdk-trigger")?.addEventListener("click", function () {
      window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
    });
  </script>
</header>
