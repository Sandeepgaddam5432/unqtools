---
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";

interface Props {
  tool: ToolManifest;
}

const { tool } = Astro.props;
---

<article class="space-y-6">
  <header class="space-y-2">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{tool.name}</h1>
    <p class="text-base text-unq-muted sm:text-lg">{tool.description}</p>
    <p class="text-xs uppercase tracking-wider text-unq-muted">
      {CATEGORY_LABELS[tool.category]} · {tool.requiresNetwork ? "needs network" : "works offline"}
    </p>
  </header>

  <div class="unq-card flex items-center gap-2 p-3 text-xs text-unq-muted">
    <span aria-hidden="true">🔒</span>
    <span
      ><strong>Privacy:</strong> this tool runs entirely in your browser. Your input never leaves your
      device.</span
    >
  </div>

  <slot />
</article>
