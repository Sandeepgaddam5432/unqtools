---
/**
 * CategoryChips — horizontal pill row shown on mobile (≤1024px) in place of
 * the desktop sidebar. Same data, compact form.
 */
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../lib/tool";
import { countByCategory } from "../lib/registry";

interface Props {
  active?: ToolCategory;
}

const { active } = Astro.props;
const counts = countByCategory();
const categoriesWithTools = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
---

<nav class="unq-cat-chips" aria-label="Tool categories">
  <a href="/" aria-current={active === undefined ? "page" : undefined}>All</a>
  {
    categoriesWithTools.map((c) => (
      <a href={`/category/${c}`} aria-current={c === active ? "page" : undefined}>
        {CATEGORY_LABELS[c].split(" ")[0]}
      </a>
    ))
  }
</nav>
