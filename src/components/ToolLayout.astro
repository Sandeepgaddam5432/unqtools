---
/**
 * ToolLayout — the consistent shell for every tool page.
 *
 * Sections:
 *  1. Breadcrumb (home / category / tool name)
 *  2. Eyebrow (category label) + title + subtitle + status badges
 *  3. ToolActions bar (Copy / Download / Share / Print / Reset) — slot
 *  4. The tool's actual UI — <slot />
 *  5. Privacy notice
 *  6. Related tools (same category, max 4)
 *  7. SEO content (intro + How-to + FAQ) — driven by tool manifest
 */
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { byCategory } from "../lib/registry";
import Breadcrumb from "./ui/Breadcrumb.astro";
import ToolCard from "./ToolCard.astro";

interface Props {
  tool: ToolManifest;
}

const { tool } = Astro.props;
const relatedTools = byCategory(tool.category)
  .filter((t) => t.id !== tool.id)
  .slice(0, 4);
const categoryLabel = CATEGORY_LABELS[tool.category];
---

<article class="space-y-8">
  <!-- Breadcrumb -->
  <Breadcrumb
    items={[
      { label: "All tools", href: "/" },
      { label: categoryLabel, href: `/category/${tool.category}` },
      { label: tool.name },
    ]}
  />

  <!-- Header -->
  <header class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-unq-accent">
        {categoryLabel}
      </span>
      {
        tool.requiresNetwork ? (
          <span class="inline-flex items-center gap-1 rounded-full bg-unq-warning-subtle px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-unq-warning">
            Needs network
          </span>
        ) : (
          <span class="inline-flex items-center gap-1 rounded-full bg-unq-success-subtle px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-unq-success">
            Offline-ready
          </span>
        )
      }
    </div>
    <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
      {tool.name}
    </h1>
    <p class="max-w-2xl text-pretty text-base text-unq-text-muted sm:text-lg">
      {tool.description}
    </p>
  </header>

  <!-- Tool UI (slot) -->
  <div class="unq-card p-5 sm:p-6">
    <slot />
  </div>

  <!-- Privacy notice -->
  <div
    class="border-unq-success/30 flex items-start gap-3 rounded-lg border bg-unq-success-subtle p-4"
    role="note"
  >
    <svg
      class="mt-0.5 shrink-0 text-unq-success"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <div>
      <p class="text-sm font-medium text-unq-text">100% private</p>
      <p class="mt-0.5 text-sm text-unq-text-muted">
        This tool runs entirely in your browser. Your input never leaves your device — no uploads,
        no tracking, no accounts.
      </p>
    </div>
  </div>

  <!-- Related tools -->
  {
    relatedTools.length > 0 && (
      <section>
        <h2 class="mb-4 text-lg font-semibold">Related tools</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {relatedTools.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      </section>
    )
  }

  <!-- SEO content -->
  <section
    class="prose prose-sm prose-headings:tracking-tight prose-p:text-unq-text-muted prose-h2:text-unq-text prose-h3:text-unq-text prose-strong:text-unq-text prose-code:text-unq-text prose-code:bg-unq-surface-hover prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none max-w-none"
  >
    <h2>About {tool.name}</h2>
    <p>{tool.description}</p>

    <h3>How to use</h3>
    <ol>
      <li>Enter your input in the tool above.</li>
      <li>Adjust any options (indent, format, etc.) to your preference.</li>
      <li>
        Use the <strong>Copy</strong> or <strong>Download</strong> buttons to save the result.
      </li>
      <li>Everything happens locally — your data never leaves your browser.</li>
    </ol>

    {
      tool.seo?.faq && tool.seo.faq.length > 0 && (
        <>
          <h3>Frequently asked questions</h3>
          <dl>
            {tool.seo.faq.map((item) => (
              <>
                <dt class="font-semibold text-unq-text">{item.q}</dt>
                <dd class="mb-3">{item.a}</dd>
              </>
            ))}
          </dl>
        </>
      )
    }
  </section>
</article>
