---
/**
 * ToolLayout v2.1 — Apple.com-grade UI.
 * Consistent shell for every tool page.
 */
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { byCategory } from "../lib/registry";
import Breadcrumb from "./ui/Breadcrumb.astro";
import ToolCard from "./ToolCard.astro";

interface Props {
  tool: ToolManifest;
}

const { tool } = Astro.props;
const relatedTools = byCategory(tool.category)
  .filter((t) => t.id !== tool.id)
  .slice(0, 4);
const categoryLabel = CATEGORY_LABELS[tool.category];
---

<article style="display: flex; flex-direction: column; gap: 40px;">
  <!-- Breadcrumb -->
  <Breadcrumb
    items={[
      { label: "All tools", href: "/" },
      { label: categoryLabel, href: `/category/${tool.category}` },
      { label: tool.name },
    ]}
  />

  <!-- Header — Apple: text-3 breadcrumb, accent eyebrow, h1 title, muted subtitle -->
  <header style="display: flex; flex-direction: column; gap: 16px;">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="unq-eyebrow">{categoryLabel}</span>
      {
        tool.requiresNetwork ? (
          <span class="ring-unq-warning/20 inline-flex items-center gap-1.5 rounded-full bg-unq-warning-subtle px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-unq-text ring-1">
            <span class="h-1.5 w-1.5 rounded-full bg-unq-warning" />
            Needs network
          </span>
        ) : (
          <span class="ring-unq-success/20 inline-flex items-center gap-1.5 rounded-full bg-unq-success-subtle px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-unq-text ring-1">
            <span class="h-1.5 w-1.5 rounded-full bg-unq-success" />
            Offline-ready
          </span>
        )
      }
    </div>
    <h1 class="unq-h1" style="margin: 0;">{tool.name}</h1>
    <p class="unq-muted" style="font-size: 19px; line-height: 1.4; max-width: 640px;">
      {tool.description}
    </p>
  </header>

  <!-- Tool UI (slot) — wrapped in an Apple tile (.unq-card) -->
  <div class="unq-card" style="padding: clamp(20px, 4vw, 32px);">
    <slot />
  </div>

  <!-- Privacy notice — Apple-style green-tinted -->
  <div
    class="border-unq-success/20 flex items-start gap-3.5 rounded-xl border bg-unq-success-subtle p-5"
    role="note"
  >
    <svg
      class="mt-0.5 shrink-0 text-unq-success"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <div>
      <p class="text-sm font-semibold text-unq-text">100% private</p>
      <p class="text-unq-text-2 mt-0.5 text-sm leading-relaxed">
        This tool runs entirely in your browser. Your input never leaves your device — no uploads,
        no tracking, no accounts.
      </p>
    </div>
  </div>

  <!-- Related tools — Apple spacing -->
  {
    relatedTools.length > 0 && (
      <section>
        <div class="unq-section-head">
          <h2 class="unq-h3">Related tools</h2>
        </div>
        <div class="unq-grid unq-reveal">
          {relatedTools.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      </section>
    )
  }

  <!-- SEO content — Apple typography -->
  <section
    class="prose prose-sm prose-headings:tracking-display prose-headings:font-semibold prose-p:text-unq-text-2 prose-p:leading-relaxed prose-h2:text-unq-text prose-h2:unq-h2 prose-h3:text-unq-text prose-strong:text-unq-text prose-code:text-unq-text prose-code:bg-unq-surface-hover prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none prose-li:text-unq-text-2 prose-li:leading-relaxed prose-ol:marker:text-unq-text-3 max-w-none"
  >
    <h2>About {tool.name}</h2>
    <p>{tool.description}</p>

    <h3>How to use</h3>
    <ol>
      <li>Enter your input in the tool above.</li>
      <li>Adjust any options (indent, format, etc.) to your preference.</li>
      <li>
        Use the <strong>Copy</strong> or <strong>Download</strong> buttons to save the result.
      </li>
      <li>Everything happens locally — your data never leaves your browser.</li>
    </ol>

    {
      tool.seo?.faq && tool.seo.faq.length > 0 && (
        <>
          <h3>Frequently asked questions</h3>
          <dl>
            {tool.seo.faq.map((item) => (
              <>
                <dt class="font-semibold text-unq-text">{item.q}</dt>
                <dd class="mb-4 leading-relaxed">{item.a}</dd>
              </>
            ))}
          </dl>
        </>
      )
    }
  </section>
</article>
