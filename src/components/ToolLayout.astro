---
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { byCategory } from "../lib/registry";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  tool: ToolManifest;
}
const { tool } = Astro.props;
const relatedTools = byCategory(tool.category)
  .filter((t) => t.id !== tool.id)
  .slice(0, 3);
const categoryLabel = CATEGORY_LABELS[tool.category];
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
const glyph = ICON_MAP[tool.icon] ?? tool.icon.slice(0, 2).toUpperCase();
---

<BaseLayout title={tool.seo?.title ?? `${tool.name} — UnQTools`} description={tool.description}>
  {/* Tool header — ported from toolhub ToolLayout */}
  <header class="border-b border-border bg-surface/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 py-4">
        <div class="flex min-w-0 items-center gap-3">
          <a
            href="/"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-fg transition-colors hover:bg-surface-2"
            aria-label="Back to home"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
            >
          </a>
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-soft font-mono text-sm text-accent"
          >
            {glyph}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h1 class="truncate text-lg font-semibold tracking-tight">{tool.name}</h1>
              <span
                class="hidden items-center rounded-full border border-border px-2 py-0.5 text-2xs font-medium text-fg-muted md:inline-flex"
                >{categoryLabel}</span
              >
            </div>
            <p class="truncate text-xs text-fg-muted">{tool.description}</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/* Tool body */}
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div style="min-height: 400px;"><slot /></div>

    {/* Privacy note — ported from toolhub's footer line */}
    <p class="mt-6 flex items-center gap-1.5 text-xs text-fg-subtle">
      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
        ></polyline></svg
      >
      100% client-side · No data leaves your browser · Calculations run locally
    </p>

    {/* Related tools — ported from toolhub's related section */}
    {
      relatedTools.length > 0 && (
        <section class="mt-10 border-t border-border pt-6">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-fg-muted">
            Related tools
          </h2>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTools.map((rt) => {
              const g = ICON_MAP[rt.icon] ?? rt.icon.slice(0, 2).toUpperCase();
              return (
                <a
                  href={`/tools/${rt.id}`}
                  class="tool-card group flex items-center gap-3 rounded-xl"
                >
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-accent-soft font-mono text-xs text-accent">
                    {g}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-medium">{rt.name}</div>
                    <div class="truncate text-xs text-fg-muted">{rt.description}</div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {/* SEO content: How-to + FAQ — ported from toolhub's SEO section */}
    <section class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="mb-3 text-base font-semibold tracking-tight">How to use</h2>
        <ol class="space-y-2.5">
          <li class="flex gap-3 text-sm text-fg-muted">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent"
              >1</span
            >
            <span class="leading-relaxed">Enter your input in the tool above.</span>
          </li>
          <li class="flex gap-3 text-sm text-fg-muted">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent"
              >2</span
            >
            <span class="leading-relaxed">Adjust any options to your preference.</span>
          </li>
          <li class="flex gap-3 text-sm text-fg-muted">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent"
              >3</span
            >
            <span class="leading-relaxed">Use the Copy or Download buttons to save the result.</span
            >
          </li>
          <li class="flex gap-3 text-sm text-fg-muted">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent"
              >4</span
            >
            <span class="leading-relaxed"
              >Everything happens locally — your data never leaves your browser.</span
            >
          </li>
        </ol>
      </div>

      {
        tool.seo?.faq && tool.seo.faq.length > 0 && (
          <div class="rounded-xl border border-border bg-surface p-5">
            <h2 class="mb-3 text-base font-semibold tracking-tight">Frequently asked questions</h2>
            <div class="space-y-3">
              {tool.seo.faq.map((faq) => (
                <div>
                  <h3 class="text-sm font-medium text-fg">{faq.q}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-fg-muted">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
