---
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { byCategory } from "../lib/registry";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  tool: ToolManifest;
}
const { tool } = Astro.props;
const relatedTools = byCategory(tool.category)
  .filter((t) => t.id !== tool.id)
  .slice(0, 4);
const categoryLabel = CATEGORY_LABELS[tool.category];
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
const glyph = ICON_MAP[tool.icon] ?? tool.icon.slice(0, 2).toUpperCase();
---

<BaseLayout
  title={tool.seo?.title ?? `${tool.name} — UnQTools`}
  description={tool.description}
  activeCategory={tool.category}
>
  <div class="content-wrap" style="display:flex;flex-direction:column;gap:24px;padding-top:32px;">
    {/* Breadcrumb */}
    <nav
      style="display:flex;align-items:center;gap:6px;font-size:var(--text-sm);color:var(--text-muted);"
      aria-label="Breadcrumb"
    >
      <a href="/" style="color:var(--text-muted);text-decoration:none;">All tools</a>
      <span style="color:var(--text-subtle);">›</span>
      <a href={`/category/${tool.category}`} style="color:var(--text-muted);text-decoration:none;"
        >{categoryLabel}</a
      >
      <span style="color:var(--text-subtle);">›</span>
      <span style="font-weight:500;color:var(--text);">{tool.name}</span>
    </nav>

    {/* Header */}
    <header style="display:flex;flex-direction:column;gap:12px;">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;">
        <span
          class="card__icon"
          aria-hidden="true"
          style="width:40px;height:40px;border-radius:10px;font-size:18px;">{glyph}</span
        >
        <span class="eyebrow">{categoryLabel}</span>
        {
          tool.requiresNetwork ? (
            <span style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:99px;background:var(--warning-subtle);font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text);">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--warning);" />{" "}
              Needs network
            </span>
          ) : (
            <span style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:99px;background:var(--success-subtle);font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text);">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--success);" />{" "}
              Offline-ready
            </span>
          )
        }
      </div>
      <h1 style="font-size:var(--text-h1);">{tool.name}</h1>
      <p class="muted" style="font-size:var(--text-sm);max-width:580px;margin:0;">
        {tool.description}
      </p>
    </header>

    {/* Tool UI (slot) */}
    <div style="min-height:400px;"><slot /></div>

    {/* Privacy notice */}
    <div
      style="display:flex;align-items:start;gap:12px;padding:16px;border-radius:var(--radius-sm);background:var(--success-subtle);border:1px solid var(--border-subtle);"
      role="note"
    >
      <svg
        style="margin-top:2px;flex-shrink:0;color:var(--success);"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
        ></path></svg
      >
      <div>
        <p style="font-size:var(--text-sm);font-weight:600;margin:0;">100% private</p>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin:2px 0 0;">
          This tool runs entirely in your browser. Your input never leaves your device.
        </p>
      </div>
    </div>

    {/* Related tools */}
    {
      relatedTools.length > 0 && (
        <section>
          <div class="section-head">
            <h2 style="font-size:var(--text-h3);">Related tools</h2>
          </div>
          <div class="tool-grid reveal">
            {relatedTools.map((t) => {
              const g = ICON_MAP[t.icon] ?? t.icon.slice(0, 2).toUpperCase();
              return (
                <a href={`/tools/${t.id}`} class="glass-card glass-card-hover card">
                  <span class="card__icon" aria-hidden="true">
                    {g}
                  </span>
                  <h3 class="card__title">{t.name}</h3>
                  <p class="card__desc">{t.description}</p>
                  <div class="card__tags">
                    <span class="card__tag">{categoryLabel.split(" ")[0]}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {/* SEO content */}
    <section class="reveal" style="max-width:680px;">
      <h2 style="font-size:var(--text-h3);margin:0 0 8px;">About {tool.name}</h2>
      <p class="muted" style="font-size:var(--text-sm);margin:0 0 16px;">{tool.description}</p>
      <h3 style="font-size:var(--text-sm);font-weight:600;margin:0 0 8px;">How to use</h3>
      <ol
        style="font-size:var(--text-sm);color:var(--text-muted);padding-left:20px;margin:0 0 16px;line-height:1.6;"
      >
        <li>Enter your input in the tool above.</li>
        <li>Adjust any options to your preference.</li>
        <li>Use the Copy or Download buttons to save the result.</li>
        <li>Everything happens locally — your data never leaves your browser.</li>
      </ol>
      {
        tool.seo?.faq && tool.seo.faq.length > 0 && (
          <>
            <h3 style="font-size:var(--text-sm);font-weight:600;margin:0 0 8px;">FAQ</h3>
            <div style="display:flex;flex-direction:column;gap:8px;">
              {tool.seo.faq.map((item) => (
                <details style="border-bottom:1px solid var(--border-subtle);padding:12px 0;">
                  <summary style="cursor:pointer;font-weight:600;font-size:var(--text-sm);color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;">
                    {item.q}
                    <span style="color:var(--text-muted);">+</span>
                  </summary>
                  <div style="color:var(--text-muted);font-size:var(--text-sm);line-height:1.6;padding-top:8px;overflow-wrap:break-word;">
                    {item.a}
                  </div>
                </details>
              ))}
            </div>
          </>
        )
      }
    </section>
  </div>
</BaseLayout>
