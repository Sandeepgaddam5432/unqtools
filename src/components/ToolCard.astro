---
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { Star } from "lucide-preact";

interface Props {
  tool: ToolManifest;
}

const { tool } = Astro.props;
const categoryShort = CATEGORY_LABELS[tool.category].split(" ")[0];
---

<a
  href={`/tools/${tool.id}`}
  class="unq-card unq-card-interactive group relative block"
  data-tool-id={tool.id}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3
        class="unq-card__title duration-normal transition-colors ease-apple group-hover:text-unq-accent"
      >
        {tool.name}
      </h3>
      <p class="unq-card__desc mt-1.5 line-clamp-2 text-pretty">
        {tool.description}
      </p>
    </div>
    <button
      type="button"
      class="favorite-btn duration-normal text-unq-text-3 absolute right-4 top-4 p-1 opacity-0 transition-opacity ease-apple hover:text-unq-warning focus:opacity-100 group-hover:opacity-100"
      data-favorite-id={tool.id}
      aria-label={`Favorite ${tool.name}`}
      onclick="event.preventDefault(); event.stopPropagation(); window.dispatchEvent(new CustomEvent('unq:toggle-favorite', { detail: this.dataset.favoriteId }));"
    >
      <Star size={15} />
    </button>
  </div>
  <p class="unq-card__cat">{categoryShort}</p>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
