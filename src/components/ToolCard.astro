---
import type { ToolManifest } from "../lib/tool";
import { CATEGORY_LABELS } from "../lib/tool";
import { Star } from "lucide-preact";

interface Props {
  tool: ToolManifest;
  /** Featured cards get a subtle accent-tinted border + background. */
  featured?: boolean;
}

const { tool, featured = false } = Astro.props;
const categoryShort = CATEGORY_LABELS[tool.category].split(" ")[0];

// Map the manifest `icon` string (lucide name or short token) to a compact
// glyph shown in the card's icon tile. Falls back to the first letter.
const ICON_MAP: Record<string, string> = {
  braces: "{ }",
  binary: "01",
  link: "🔗",
  hash: "#",
  type: "Aa",
  image: "🎨",
  calculator: "🧮",
  "trending-up": "📈",
  home: "🏠",
  palette: "🎨",
  fingerprint: "🔑",
};
const glyph = ICON_MAP[tool.icon] ?? tool.icon.slice(0, 2).toUpperCase();
---

<a
  href={`/tools/${tool.id}`}
  class={`unq-card unq-card-interactive group relative block${featured ? " unq-card--featured" : ""}`}
  data-tool-id={tool.id}
>
  <div class="flex items-start justify-between gap-3">
    <span class="unq-card__icon" aria-hidden="true">{glyph}</span>
    <button
      type="button"
      class="favorite-btn duration-normal text-unq-text-3 absolute right-4 top-4 p-1 opacity-0 transition-opacity ease-apple hover:text-unq-warning focus:opacity-100 group-hover:opacity-100"
      data-favorite-id={tool.id}
      aria-label={`Favorite ${tool.name}`}
      onclick="event.preventDefault(); event.stopPropagation(); window.dispatchEvent(new CustomEvent('unq:toggle-favorite', { detail: this.dataset.favoriteId }));"
    >
      <Star size={15} />
    </button>
  </div>
  <h3
    class="unq-card__title duration-normal transition-colors ease-apple group-hover:text-unq-accent"
  >
    {tool.name}
  </h3>
  <p class="unq-card__desc text-pretty">{tool.description}</p>
  <p class="unq-card__cat">{categoryShort}</p>
</a>
