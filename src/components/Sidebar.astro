---
/**
 * Sidebar — sticky left category nav for desktop (≥1024px).
 * Lists all 13 categories with icon + name + live tool count.
 * The active category gets aria-current="page" + accent bg.
 *
 * On mobile (≤1024px) this is hidden; the mobile category chip row
 * (.unq-cat-chips) is shown instead, rendered by the page itself.
 */
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../lib/tool";
import { countByCategory } from "../lib/registry";

interface Props {
  /** The currently-active category (gets aria-current="page"). Omit on homepage. */
  active?: ToolCategory;
}

const { active } = Astro.props;
const counts = countByCategory();

const CATEGORY_ICONS: Record<ToolCategory, string> = {
  pdf: "📄",
  image: "🎨",
  "audio-video": "🎬",
  developer: "{ }",
  seo: "🔍",
  calculators: "🧮",
  text: "Aa",
  "network-security": "🔒",
  file: "📦",
  business: "💼",
  education: "📚",
  social: "👥",
  ai: "✨",
};

// Only show categories that actually have tools (keeps the sidebar clean).
const categoriesWithTools = ALL_CATEGORIES.filter((c) => (counts[c] ?? 0) > 0);
---

<aside class="unq-sidebar" aria-label="Tool categories">
  <p class="unq-sidebar__title">Categories</p>
  <a
    href="/"
    aria-current={active === undefined ? "page" : undefined}
    style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; color: var(--fg-muted); font-size: var(--text-sm); text-decoration: none; transition: background .15s var(--ease-spring), color .15s var(--ease-spring); min-height: 36px;"
  >
    <span class="unq-sidebar__icon" aria-hidden="true">★</span>
    <span class="unq-sidebar__label">All tools</span>
  </a>
  {
    categoriesWithTools.map((c) => {
      const count = counts[c] ?? 0;
      const isActive = c === active;
      return (
        <a href={`/category/${c}`} aria-current={isActive ? "page" : undefined}>
          <span class="unq-sidebar__icon" aria-hidden="true">
            {CATEGORY_ICONS[c]}
          </span>
          <span class="unq-sidebar__label">{CATEGORY_LABELS[c]}</span>
          <span class="unq-sidebar__count">{count}</span>
        </a>
      );
    })
  }
</aside>
