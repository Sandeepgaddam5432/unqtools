---
import "../styles/global.css";
import { themeNoFoUcScript } from "../lib/theme";
import CommandBarMount from "../components/CommandBarMount.astro";

interface Props {
  title?: string;
  description?: string;
  activeCategory?: string;
}

const {
  title = "UnQTools — All-in-One Utility Hub (100% Private, No Backend)",
  description = "Premium collection of free online tools — calculators, converters, formatters. 100% client-side, privacy-first, no uploads.",
} = Astro.props;

const site = Astro.site ?? new URL("https://unqtools.pages.dev");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL("/icons/icon-512.png", site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <title>{title}</title>
    <script is:inline set:html={themeNoFoUcScript} />
    <meta name="view-transition" content="same-origin" />
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prefetch: [{ where: { href_matches: "/tools/*" }, eagerness: "moderate" }],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only"
      style="position:absolute;left:12px;top:12px;z-index:99;background:oklch(var(--accent));color:oklch(var(--accent-fg));padding:8px 16px;border-radius:8px;font-size:14px;"
      >Skip to content</a
    >

    {/* Glass header — ported from toolhub Header.tsx */}
    <header class="glass sticky top-0 z-40 border-b border-border">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-14 items-center justify-between gap-3">
          <a href="/" class="flex shrink-0 items-center gap-2" aria-label="UnQTools home">
            <div
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-sm font-bold text-accent-fg"
            >
              U
            </div>
            <span class="hidden text-base font-semibold tracking-tight sm:inline">UnQTools</span>
          </a>
          <div class="max-w-md flex-1">
            <button
              id="cmdk-trigger"
              class="flex w-full items-center gap-2 rounded-md border border-border bg-surface px-3 py-1.5 text-sm text-fg-subtle transition-colors hover:bg-surface-2"
              aria-label="Search tools (⌘K)"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
              >
              <span class="flex-1 text-left">Search tools…</span>
              <kbd
                class="hidden items-center rounded border border-border bg-surface-2 px-1.5 py-0.5 font-mono text-2xs font-medium sm:inline-flex"
                >⌘K</kbd
              >
            </button>
          </div>
          <div class="flex shrink-0 items-center gap-1.5">
            <button
              id="theme-toggle"
              class="flex h-9 w-9 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
              aria-label="Toggle color theme"
              title="Toggle theme"
            >
              <svg
                id="theme-icon-sun"
                class="hidden h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="4"></circle><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path></svg
              >
              <svg
                id="theme-icon-moon"
                class="hidden h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
              >
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    {/* Footer — ported from toolhub Footer */}
    <footer class="mt-20 border-t border-border py-8">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col items-center justify-between gap-3 text-xs text-fg-subtle sm:flex-row"
        >
          <p class="flex items-center gap-1.5">
            <span class="font-medium text-fg-muted">UnQTools</span>
            · 100% client-side · No tracking · No uploads
          </p>
          <p>Built with Astro, Preact &amp; WebAssembly</p>
        </div>
      </div>
    </footer>

    <CommandBarMount />

    {/* Theme + cmdk scripts */}
    <script is:inline>
      (function () {
        const KEY = "unq-theme";
        const btn = document.getElementById("theme-toggle");
        const sun = document.getElementById("theme-icon-sun");
        const moon = document.getElementById("theme-icon-moon");
        function current() {
          const v = localStorage.getItem(KEY);
          return v === "light" || v === "dark" || v === "system" ? v : "system";
        }
        function resolved(t) {
          return t === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : t;
        }
        function paint() {
          const r = resolved(current());
          if (sun && moon) {
            sun.classList.toggle("hidden", r !== "light");
            moon.classList.toggle("hidden", r !== "dark");
          }
        }
        btn?.addEventListener("click", () => {
          const next = resolved(current()) === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem(KEY, next);
          paint();
        });
        paint();
      })();
    </script>
    <script is:inline>
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
        }
      });
      document.getElementById("cmdk-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
      });
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
      }
    </script>
  </body>
</html>
