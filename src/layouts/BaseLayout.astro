---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/700.css";
import { themeNoFoUcScript } from "../lib/theme";
import { TOOLS } from "../lib/registry";
import { ALL_CATEGORIES, CATEGORY_LABELS, type ToolCategory } from "../lib/tool";
import CommandBarMount from "../components/CommandBarMount.astro";

interface Props {
  title?: string;
  description?: string;
  activeCategory?: ToolCategory;
}

const {
  title = "UnQTools — Free, private, offline browser tools",
  description = "UnQTools is a 100% static, privacy-first, offline-capable PWA of fast browser-based tools.",
  activeCategory,
} = Astro.props;

const site = Astro.site ?? new URL("https://unqtools.pages.dev");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL("/icons/icon-512.png", site);
const counts = ALL_CATEGORIES.reduce(
  (acc, c) => {
    acc[c] = TOOLS.filter((t) => t.category === c).length;
    return acc;
  },
  {} as Record<string, number>,
);
const cats = ALL_CATEGORIES.filter((c) => counts[c] > 0).slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <title>{title}</title>
    <script is:inline set:html={themeNoFoUcScript} />
    <meta name="view-transition" content="same-origin" />
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prefetch: [{ where: { href_matches: "/tools/*" }, eagerness: "moderate" }],
        prerender: [{ where: { selector_matches: ".card a" }, eagerness: "moderate" }],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only"
      style="position:absolute;left:12px;top:12px;z-index:99;background:var(--primary-fill);color:#fff;padding:8px 16px;border-radius:8px;font-size:14px;"
      >Skip to content</a
    >
    <div class="progress-bar" aria-hidden="true"></div>

    {/* Floating pill glass nav */}
    <nav class="nav-pill glass-card">
      <a href="/" class="nav-pill__logo" aria-label="UnQTools home">
        <span class="nav-pill__logo-mark">U</span>
        <span>UnQTools</span>
      </a>
      <div class="nav-pill__links">
        {
          cats.map((c) => (
            <a href={`/category/${c}`} aria-current={c === activeCategory ? "page" : undefined}>
              {CATEGORY_LABELS[c].split(" ")[0]}
            </a>
          ))
        }
      </div>
      <button class="nav-pill__search" id="cmdk-trigger" aria-label="Open command palette (⌘K)">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
        >
        <span>Search tools…</span>
        <span class="nav-pill__search-hint">⌘K</span>
      </button>
      <div class="nav-pill__actions">
        <button
          class="nav-pill__btn"
          id="theme-toggle"
          aria-label="Toggle color theme"
          title="Toggle theme"
        >
          <svg
            id="theme-icon-sun"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path></svg
          >
          <svg
            id="theme-icon-moon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
            aria-hidden="true"
            ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
          >
        </button>
      </div>
    </nav>

    {/* Mobile category chips */}
    {
      activeCategory !== undefined && (
        <div class="filter-chips content-wrap" style="padding-top:80px;">
          <a
            href="/"
            class="filter-chip"
            aria-current={activeCategory === undefined ? "page" : undefined}
          >
            All
          </a>
          {ALL_CATEGORIES.filter((c) => counts[c] > 0).map((c) => (
            <a
              href={`/category/${c}`}
              class="filter-chip"
              aria-current={c === activeCategory ? "page" : undefined}
            >
              {CATEGORY_LABELS[c].split(" ")[0]}
            </a>
          ))}
        </div>
      )
    }

    <main id="main" style="padding-top:72px;">
      <slot />
    </main>

    {/* Footer */}
    <footer class="footer">
      <div class="footer__grid">
        <div class="footer__col">
          <a href="/" class="nav-pill__logo" style="margin-bottom:12px;">
            <span class="nav-pill__logo-mark">U</span><span>UnQTools</span>
          </a>
          <p
            style="color:var(--text-muted);font-size:var(--text-sm);max-width:280px;margin:8px 0 0;"
          >
            {TOOLS.length} browser-based tools — all private, all offline-capable.
          </p>
        </div>
        <div class="footer__col">
          <h3>Categories</h3>
          <ul>
            <li><a href="/category/developer">Developer</a></li>
            <li><a href="/category/calculators">Calculators</a></li>
            <li><a href="/category/text">Text &amp; Writing</a></li>
            <li><a href="/category/image">Image</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h3>Popular</h3>
          <ul>
            <li><a href="/tools/json-formatter">JSON Formatter</a></li>
            <li><a href="/tools/diff-checker">Diff Checker</a></li>
            <li><a href="/tools/base64">Base64</a></li>
            <li><a href="/tools/caesar-cipher">Caesar Cipher</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h3>About</h3>
          <ul>
            <li>100% private</li>
            <li>Installable PWA</li>
            <li>Works offline</li>
            <li>
              <a
                href="https://github.com/Sandeepgaddam5432/unqtools/blob/main/LICENSE"
                target="_blank"
                rel="noopener">LICENSE</a
              >
            </li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <p>&copy; {new Date().getFullYear()} UnQTools. All rights reserved.</p>
        <p>Proprietary &amp; confidential · 100% static</p>
      </div>
    </footer>

    <CommandBarMount />

    {/* Reveal + spotlight + theme + cmdk scripts */}
    <script is:inline>
      (function () {
        function init() {
          const rm = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const reveals = document.querySelectorAll(".reveal:not(.is-in)");
          if (rm || !("IntersectionObserver" in window)) {
            reveals.forEach((el) => el.classList.add("is-in"));
          } else {
            const io = new IntersectionObserver(
              (entries) => {
                entries.forEach((e) => {
                  if (e.isIntersecting) {
                    e.target.classList.add("is-in");
                    io.unobserve(e.target);
                  }
                });
              },
              { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
            );
            reveals.forEach((el, i) => {
              el.style.setProperty("--i", i % 6);
              io.observe(el);
            });
          }
          if (!rm) {
            document.querySelectorAll(".glass-card-hover:not([data-spot])").forEach((card) => {
              card.dataset.spot = "1";
              card.addEventListener("pointermove", (e) => {
                const r = card.getBoundingClientRect();
                card.style.setProperty("--mx", e.clientX - r.left + "px");
                card.style.setProperty("--my", e.clientY - r.top + "px");
              });
            });
          }
          // Count-up
          document.querySelectorAll("[data-countup]").forEach((el) => {
            if (rm) {
              el.textContent = el.getAttribute("data-countup");
              return;
            }
            const cio = new IntersectionObserver(
              (entries) => {
                entries.forEach((e) => {
                  if (!e.isIntersecting) return;
                  cio.unobserve(e.target);
                  const end = Number(e.target.getAttribute("data-countup"));
                  const t0 = performance.now();
                  const dur = 1200;
                  function tick(t) {
                    const p = Math.min(1, (t - t0) / dur);
                    e.target.textContent = Math.round(
                      end * (1 - Math.pow(1 - p, 3)),
                    ).toLocaleString();
                    if (p < 1) requestAnimationFrame(tick);
                  }
                  requestAnimationFrame(tick);
                });
              },
              { threshold: 0.6 },
            );
            cio.observe(el);
          });
        }
        document.addEventListener("astro:page-load", init);
        init();
      })();
    </script>
    <script is:inline>
      (function () {
        const KEY = "unq-theme";
        const btn = document.getElementById("theme-toggle");
        const sun = document.getElementById("theme-icon-sun");
        const moon = document.getElementById("theme-icon-moon");
        function current() {
          const v = localStorage.getItem(KEY);
          return v === "light" || v === "dark" || v === "system" ? v : "system";
        }
        function resolved(t) {
          return t === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : t;
        }
        function paint() {
          const r = resolved(current());
          if (sun && moon) {
            sun.classList.toggle("hidden", r !== "light");
            moon.classList.toggle("hidden", r !== "dark");
          }
        }
        btn?.addEventListener("click", () => {
          const next = resolved(current()) === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem(KEY, next);
          paint();
        });
        paint();
      })();
    </script>
    <script is:inline>
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
        }
      });
      document.getElementById("cmdk-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("unq:open-command-bar"));
      });
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
      }
    </script>
  </body>
</html>
