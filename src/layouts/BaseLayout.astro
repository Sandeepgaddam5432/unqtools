---
import "../styles/global.css";
import { themeNoFoUcScript } from "../lib/theme";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path to OG image relative to site root. Defaults to /og-default.png. */
  ogImage?: string;
}

const {
  title = "UnQTools — Free, private, offline browser tools",
  description = "UnQTools is a 100% static, privacy-first, offline-capable PWA of fast browser-based tools. Your data never leaves your browser.",
  ogImage = "/icons/icon-512.png",
} = Astro.props;

// Astro.site is configured in astro.config.mjs and drives absolute URLs for
// canonical, OG, and sitemap. Never hardcode the origin here.
const site = Astro.site ?? new URL("https://unqtools.pages.dev");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);
const ogType = Astro.url.pathname === "/" ? "website" : "article";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {/* Canonical URL — absolute, derived from astro.config.mjs `site`. */}
    <link rel="canonical" href={canonicalURL.href} />
    {/* Open Graph — absolute URLs required by Facebook, LinkedIn, etc. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content="UnQTools" />
    {/* Twitter/X card — same image, summary_large_image for tool pages. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <title>{title}</title>
    {/* Inline theme-init script — prevents flash of unstyled theme (FOUC) */}
    <script is:inline set:html={themeNoFoUcScript} />
  </head>
  <body>
    <a
      href="#main"
      class="focus:unq-btn focus:unq-btn-primary sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="unq-container py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
    {/* Register the service worker (PWA) */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* SW registration failures are non-fatal — the site still works online. */
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
