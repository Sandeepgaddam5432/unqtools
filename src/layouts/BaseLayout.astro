---
import "../styles/global.css";
// Self-hosted Inter — preload critical weights (400 + 600) for first paint.
// Other weights (500, 700) load lazily.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import { themeNoFoUcScript } from "../lib/theme";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandBarMount from "../components/CommandBarMount.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "UnQTools — Free, private, offline browser tools",
  description = "UnQTools is a 100% static, privacy-first, offline-capable PWA of fast browser-based tools. Your data never leaves your browser.",
  ogImage = "/icons/icon-512.png",
} = Astro.props;

const site = Astro.site ?? new URL("https://unqtools.pages.dev");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);
const ogType = Astro.url.pathname === "/" ? "website" : "article";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content="UnQTools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <title>{title}</title>
    {/* Inline theme-init script — runs BEFORE first paint, no FOUC */}
    <script is:inline set:html={themeNoFoUcScript} />
    {/* View Transitions API — smooth route changes */}
    <meta name="view-transition" content="same-origin" />
    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 200ms;
          animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
        }
      }
      @keyframes unq-slide-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-unq-accent focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-unq-accent-contrast"
    >
      Skip to content
    </a>
    <Header />
    {
      /* v3.0: pages own their shell (.unq-shell with sidebar + main). BaseLayout
        just provides <main> as a landmark — no padding/container, pages
        decide their own horizontal layout. */
    }
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Command Bar (⌘K) — hydrated client:idle so it doesn't block first paint */}
    <CommandBarMount />
    {
      /* v2.2 motion: reveal IntersectionObserver + count-up.
         Re-runs on astro:page-load so it works after Astro View Transitions. */
    }
    <script is:inline>
      (function () {
        function unqInitMotion() {
          const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const reveals = document.querySelectorAll(
            ".unq-reveal:not(.is-in), [data-reveal]:not(.is-revealed)",
          );
          if (rm || !("IntersectionObserver" in window)) {
            reveals.forEach(function (el) {
              el.classList.add("is-in");
              el.classList.add("is-revealed");
            });
          } else {
            const io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-in");
                    entry.target.classList.add("is-revealed");
                    io.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
            );
            reveals.forEach(function (el, i) {
              // Stagger index: siblings inside the same parent share a 0-5
              // counter so cards in the same grid reveal 70ms apart.
              el.style.setProperty("--i", String(i % 6));
              io.observe(el);
            });
          }
          // Count-up animation for [data-countup] elements.
          document.querySelectorAll("[data-countup]").forEach(function (el) {
            const end = Number(el.getAttribute("data-countup"));
            if (!Number.isFinite(end)) return;
            if (rm || !("IntersectionObserver" in window)) {
              el.textContent = end.toLocaleString();
              return;
            }
            const cio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  cio.unobserve(entry.target);
                  const t0 = performance.now();
                  const dur = 1200;
                  function tick(t) {
                    const p = Math.min(1, (t - t0) / dur);
                    // ease-out cubic
                    el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString();
                    if (p < 1) requestAnimationFrame(tick);
                  }
                  requestAnimationFrame(tick);
                });
              },
              { threshold: 0.6 },
            );
            cio.observe(el);
          });
        }
        document.addEventListener("astro:page-load", unqInitMotion);
        unqInitMotion();
      })();
    </script>
    {/* Service worker registration */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
